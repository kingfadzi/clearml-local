ARG BASE_IMAGE
ARG PYTHON_BUILDER_IMAGE
ARG NODE_BUILDER_IMAGE
ARG DOCKER_CLI_IMAGE
# Toolchains are prebuilt builder images; BASE_IMAGE is the runtime base.
FROM ${PYTHON_BUILDER_IMAGE} AS python-builder
USER root
COPY generated/trust/ /tmp/trust/
COPY containers/install-trust.sh /tmp/install-trust.sh
RUN sh /tmp/install-trust.sh && rm -rf /tmp/trust /tmp/install-trust.sh && python3.11 -c 'import sys; assert sys.version_info[:2] == (3,11)'

FROM ${NODE_BUILDER_IMAGE} AS node-builder
USER root
ARG PNPM_VERSION
ARG NPM_REGISTRY
COPY generated/trust/ /tmp/trust/
COPY containers/install-trust.sh /tmp/install-trust.sh
ENV NODE_EXTRA_CA_CERTS=/etc/pki/tls/certs/ca-bundle.crt
# pnpm 10 is expected in the builder image; install it from the registry only when missing.
RUN sh /tmp/install-trust.sh && rm -rf /tmp/trust /tmp/install-trust.sh && \
    (command -v pnpm >/dev/null || npm install -g --registry="$NPM_REGISTRY" "pnpm@${PNPM_VERSION}") && \
    node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 12)) process.exit(1)' && \
    pnpm --version | grep -q '^10\.'

FROM python-builder AS python-resolve
WORKDIR /build
COPY clearml /build/clearml
COPY clearml-agent /build/clearml-agent
COPY clearml-server /build/clearml-server
COPY containers/python-build.sh /build/python-build.sh
ARG PIP_INDEX_URL
ARG PIP_VERSION
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_INPUT=1 PIP_CERT=/etc/pki/tls/certs/ca-bundle.crt
RUN --mount=type=secret,id=pip_config sh /build/python-build.sh

FROM python-builder AS python-build
COPY wheelhouse /wheelhouse
COPY clearml-server /build/clearml-server

FROM node-builder AS web-build
WORKDIR /build/web
COPY clearml-web /build/web
ARG NPM_REGISTRY
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 CYPRESS_INSTALL_BINARY=0 NODE_OPTIONS=--max-old-space-size=6144
RUN --mount=type=secret,id=npm_config \
    if [ -f /run/secrets/npm_config ]; then cp /run/secrets/npm_config /tmp/npmrc; else touch /tmp/npmrc; fi && \
    NPM_CONFIG_USERCONFIG=/tmp/npmrc pnpm install --registry="$NPM_REGISTRY" --frozen-lockfile && \
    rm -f /tmp/npmrc && pnpm run build && pnpm run build-widgets

FROM ${BASE_IMAGE} AS python-runtime
USER root
COPY generated/trust/ /tmp/trust/
COPY containers/install-trust.sh /tmp/install-trust.sh
COPY containers/install-rpms.sh /tmp/install-rpms.sh
RUN sh /tmp/install-trust.sh && rm -rf /tmp/trust /tmp/install-trust.sh
RUN sh /tmp/install-rpms.sh python3.11 python3.11-pip libstdc++ libgomp shadow-utils util-linux-core
ARG PIP_VERSION
COPY --from=python-build /wheelhouse /wheelhouse
RUN python3.11 -m venv /opt/venv && /opt/venv/bin/pip install --no-index --find-links=/wheelhouse "pip==${PIP_VERSION}" && \
    /opt/venv/bin/pip install --no-index --find-links=/wheelhouse --require-hashes -r /wheelhouse/requirements.lock && rm -rf /wheelhouse && \
    useradd -u 1000 -m clearml
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 CLEARML_CONFIG_DIR=/opt/clearml/config \
    SSL_CERT_FILE=/etc/pki/tls/certs/ca-bundle.crt REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt PIP_CERT=/etc/pki/tls/certs/ca-bundle.crt
WORKDIR /opt/clearml

FROM python-runtime AS server
COPY --from=python-build /build/clearml-server/apiserver /opt/clearml/apiserver
COPY --from=python-build /build/clearml-server/fileserver /opt/clearml/fileserver
COPY containers/server-entrypoint.sh /usr/local/bin/server-entrypoint
COPY scripts/check-databases.py /opt/clearml/check-databases.py
RUN mkdir -p /opt/clearml/config /opt/clearml/log /mnt/fileserver /var/log/clearml && chown -R 1000:1000 /opt/clearml /mnt/fileserver /var/log/clearml && chmod +x /usr/local/bin/server-entrypoint
ENTRYPOINT ["/usr/local/bin/server-entrypoint"]
CMD ["apiserver"]

FROM ${DOCKER_CLI_IMAGE} AS docker-cli

FROM python-runtime AS agent
# The Docker CLI is a single binary (libc only) taken from the builder image; no RPM install here.
COPY --from=docker-cli /usr/bin/docker /usr/bin/docker
RUN /usr/bin/docker --version
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
COPY scripts/docker-policy.py /usr/local/bin/docker
RUN chmod +x /usr/local/bin/docker
ENTRYPOINT ["clearml-agent"]

FROM python-runtime AS task
# The agent reinstalls itself inside task containers; serve that from a local wheel directory.
COPY --from=python-build /wheelhouse/clearml_agent-*.whl /wheelhouse/clearml-*.whl /opt/wheels/
CMD ["python"]

FROM ${BASE_IMAGE} AS web
USER root
COPY generated/trust/ /tmp/trust/
COPY containers/install-trust.sh /tmp/install-trust.sh
COPY containers/install-rpms.sh /tmp/install-rpms.sh
RUN sh /tmp/install-trust.sh && rm -rf /tmp/trust /tmp/install-trust.sh
RUN sh /tmp/install-rpms.sh nginx shadow-utils util-linux-core && useradd -u 1000 -m clearml
COPY --from=web-build /build/web/build /usr/share/nginx/html
COPY --from=web-build /build/web/dist/report-widgets /usr/share/nginx/widgets
# The Angular application builder may nest output under browser/; serve it from the root either way.
RUN for root in /usr/share/nginx/html /usr/share/nginx/widgets; do \
      if [ -f "$root/browser/index.html" ]; then mv "$root/browser"/* "$root"/ && rmdir "$root/browser"; fi; \
      test -f "$root/index.html"; \
    done && \
    # The UI posts a telemetry/update check to a hardcoded public URL; point it at a local no-op endpoint.
    grep -l 'https://updates.clear.ml/updates' /usr/share/nginx/html/*.js | xargs -r sed -i 's#https://updates.clear.ml/updates#/offline/updates#g' && \
    ! grep -rq 'updates.clear.ml' /usr/share/nginx/html/*.js
COPY containers/nginx.conf /etc/nginx/nginx.conf
COPY containers/web-entrypoint.sh /usr/local/bin/web-entrypoint
RUN chmod +x /usr/local/bin/web-entrypoint
RUN mkdir -p /tmp/nginx && chown -R 1000:1000 /tmp/nginx /var/lib/nginx /var/log/nginx /usr/share/nginx
ENTRYPOINT ["/usr/local/bin/web-entrypoint"]
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
