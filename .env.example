# Literal KEY=value syntax; no shell expansion. Keep real .env private.
RUNTIME_BASE_IMAGE=registry.example.com/mirror/almalinux:9
PYTHON_BUILDER_IMAGE=registry.example.com/builder-images/almalinux9-python:3.11
NODE_BUILDER_IMAGE=registry.example.com/builder-images/almalinux9-node:24
SERVER_IMAGE=registry.example.com/clearml/server:local-1
WEB_IMAGE=registry.example.com/clearml/web:local-1
AGENT_IMAGE=registry.example.com/clearml/agent:local-1
TASK_IMAGE=registry.example.com/clearml/task-python:local-1
# Optional allowlist of registries and package indexes builds may contact. Exact hostnames, comma separated; blank disables the check.
ALLOWED_HOSTS=registry.example.com,pypi.example.com,npm.example.com
# Proxy for build-time downloads (dnf, pip, npm). Blank means no proxy.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=
PIP_INDEX_URL=https://pypi.example.com/repository/pypi/simple
NPM_REGISTRY=https://npm.example.com/repository/npm/
# Optional secret files for authenticated repositories, in addition to configured registry.
PIP_CONFIG_FILE=
NPM_CONFIG_FILE=
# Zip of internally signed CA certificates (.pem/.crt/.cer) downloaded into config/tls-ca-bundle.zip. Blank means no private CA is required.
TLS_CA_BUNDLE_URL=
# pip version installed in every runtime venv; the agent pins the same version inside task containers.
PIP_VERSION=25.2
BUILD_NETWORK=default
ALLOW_SOURCE_DOWNLOADS=false
MONGO_BACKEND_URI=mongodb://clearml:CHANGE_ME@data-host:27017/backend?authSource=admin
MONGO_AUTH_URI=mongodb://clearml:CHANGE_ME@data-host:27017/auth?authSource=admin
ELASTICSEARCH_URLS=http://data-host:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=CHANGE_ME
REDIS_HOST=data-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=false
CLEARML_API_URL=http://clearml-host:8008
CLEARML_WEB_URL=http://clearml-host:8080
CLEARML_FILES_URL=http://clearml-host:8081
API_PORT=8008
WEB_PORT=8080
FILES_PORT=8081
BIND_ADDRESS=0.0.0.0
DATA_DIR=./var/data
LOG_DIR=./var/log
# Enable after supplying a locally available Docker CLI RPM for the agent image.
ENABLE_AGENT=true
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_CLI_PACKAGE=docker-ce-cli
# Passed to tasks as well as the services agent. No runtime auto-update.
AGENT_WORK_DIR=/opt/clearml-agent
CLEARML_AGENT_ACCESS_KEY=
CLEARML_AGENT_SECRET_KEY=
